{
	"name": "portfolio-site-2",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "concurrently --names \"Prisma,Next.js\" --prefix \"[{name}]\" --prefix-colors \"yellow.bold,blue.bold\" \"npx prisma generate --watch\" \"next dev -H 192.168.0.104\"",
		"build": "next build",
		"start": "next start -H 192.168.0.104",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"type-check": "tsc --noEmit",
		"build:analyze": "ANALYZE=true next build",
		"preview": "next build && next start -H 192.168.0.104",
		"db:seed": "tsx prisma/seed.ts",
		"db:generate": "npx prisma generate",
		"db:push": "npx prisma db push",
		"db:migrate": "npx prisma migrate dev",
		"db:studio": "npx prisma studio",
		"db:reset": "npx prisma migrate reset"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@prisma/adapter-pg": "^7.2.0",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@svgr/webpack": "^8.1.0",
		"@vercel/blob": "^2.0.0",
		"better-auth": "^1.4.10",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.0",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^11.3.21",
		"lucide-react": "^0.541.0",
		"next": "^16.1.1-canary.15",
		"next-themes": "^0.4.6",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.70.0",
		"resend": "^4.6.0",
		"sharp": "^0.34.3",
		"sonner": "^2.0.7",
		"tailwind-merge": "^2.6.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@next/bundle-analyzer": "canary",
		"@prisma/client": "^7.2.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"concurrently": "^9.2.1",
		"postcss": "^8",
		"prisma": "^7.2.0",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"typescript": "^5"
	}
}
